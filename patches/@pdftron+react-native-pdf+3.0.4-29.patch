+- (UIImage *)syntheticWatermarkTileForLines:(NSArray<NSString *> *)lines
+                                       size:(CGSize)size
+                                    opacity:(double)opacity
+{
+    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
+    format.scale = 2.0;
+    format.opaque = NO;
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc]
+        initWithSize:size format:format];
+    NSString *text = [lines componentsJoinedByString:@"\n"];
+    NSMutableParagraphStyle *paragraphStyle = [[NSMutableParagraphStyle alloc] init];
+    paragraphStyle.alignment = NSTextAlignmentCenter;
+
+    return [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
+        NSDictionary *attributes = @{
+            NSFontAttributeName: [UIFont boldSystemFontOfSize:16.0],
+            NSForegroundColorAttributeName:
+                [[UIColor colorWithRed:0.72 green:0.05 blue:0.08 alpha:1.0]
+                    colorWithAlphaComponent:opacity],
+            NSParagraphStyleAttributeName: paragraphStyle,
+        };
+        [text drawInRect:CGRectInset((CGRect){CGPointZero, size}, 4.0, 4.0)
+          withAttributes:attributes];
+    }];
+}
+
+- (UIImage *)tiledCompositeFromTile:(UIImage *)tile
+                            tileSize:(CGSize)tileSize
+                           pageWidth:(CGFloat)pageWidth
+                          pageHeight:(CGFloat)pageHeight
+{
+    UIGraphicsImageRendererFormat *format = [UIGraphicsImageRendererFormat defaultFormat];
+    format.scale = 2.0;
+    format.opaque = NO;
+    UIGraphicsImageRenderer *renderer = [[UIGraphicsImageRenderer alloc]
+        initWithSize:CGSizeMake(pageWidth, pageHeight) format:format];
+
+    return [renderer imageWithActions:^(UIGraphicsImageRendererContext *context) {
+        CGContextRef cg = context.CGContext;
+        CGFloat angle = (CGFloat)(-50.0 * M_PI / 180.0);
+        CGFloat diagonal = (CGFloat)sqrt(pageWidth * pageWidth + pageHeight * pageHeight);
+        NSInteger count = (NSInteger)(diagonal / MIN(tileSize.width, tileSize.height)) + 4;
+
+        CGContextTranslateCTM(cg, pageWidth / 2.0, pageHeight / 2.0);
+        CGContextRotateCTM(cg, angle);
+        CGContextTranslateCTM(cg, -pageWidth / 2.0, -pageHeight / 2.0);
+        for (NSInteger row = -count; row <= count; row++) {
+            for (NSInteger column = -count; column <= count; column++) {
+                CGRect destination = CGRectMake(
+                    pageWidth / 2.0 + column * tileSize.width - tileSize.width / 2.0,
+                    pageHeight / 2.0 + row * tileSize.height - tileSize.height / 2.0,
+                    tileSize.width,
+                    tileSize.height);
+                [tile drawInRect:destination];
+            }
+        }
+    }];
+}
+
+- (BOOL)stampTiledImageWithLines:(NSArray<NSString *> *)lines
+                         opacity:(double)opacity
+                        tileSize:(CGSize)tileSize
+                           onDoc:(PTPDFDoc *)doc
+                           pages:(PTPageSet *)pages
+{
+    PTPDFRect *cropBox = [[doc GetPage:1] GetCropBox];
+    CGFloat pageWidth = (CGFloat)([cropBox GetX2] - [cropBox GetX1]);
+    CGFloat pageHeight = (CGFloat)([cropBox GetY2] - [cropBox GetY1]);
+    if (pageWidth < 1.0 || pageHeight < 1.0) {
+        return NO;
+    }
+
+    UIImage *tile = [self syntheticWatermarkTileForLines:lines
+                                                    size:tileSize
+                                                 opacity:opacity];
+    UIImage *composite = [self tiledCompositeFromTile:tile
+                                             tileSize:tileSize
+                                            pageWidth:pageWidth
+                                           pageHeight:pageHeight];
+    NSData *pngData = UIImagePNGRepresentation(composite);
+    PTSDFDoc *sdfDoc = [doc GetSDFDoc];
+    if (!pngData || !sdfDoc) {
+        return NO;
+    }
+
+    PTImage *image = [PTImage CreateWithDataSimple:sdfDoc
+                                               buf:pngData
+                                          buf_size:(unsigned long)pngData.length
+                                     encoder_hints:nil];
+    if (!image) {
+        return NO;
+    }
+
+    PTStamper *stamper = [[PTStamper alloc]
+        initWithSize_type:e_ptabsolute_size a:pageWidth b:pageHeight];
+    [stamper SetAlignment:e_pthorizontal_center
+       vertical_alignment:e_ptvertical_center];
+    [stamper SetPosition:0 vertical_distance:0 use_percentage:YES];
+    [stamper SetOpacity:1.0];
+    [stamper SetAsBackground:NO];
+    [stamper SetAsAnnotation:NO];
+    [stamper StampImage:doc src_img:image dest_pages:pages];
+    return YES;
+}
+
+- (void)applyReproWatermarkToPdfViewCtrl:(PTPDFViewCtrl *)pdfViewCtrl
+{
+    if (_watermarkStamped) {
+        return;
+    }
+
+    NSArray *lines = [_watermarkConfig[@"lines"] isKindOfClass:[NSArray class]]
+        ? _watermarkConfig[@"lines"] : nil;
+    if (lines.count == 0) {
+        [self emitWatermarkResult:NO reason:@"watermark-config-missing"
+                       pageCount:0 lockWaitMs:0 stampMs:0 totalMs:0];
+        return;
+    }
+
+    NSString *text = [lines componentsJoinedByString:@"\n"];
+    double opacity = _watermarkConfig[@"opacity"]
+        ? [_watermarkConfig[@"opacity"] doubleValue] : 0.18;
+    BOOL useTiledImage = [_watermarkConfig[@"mode"] isEqualToString:@"tiledImage"];
+    CGFloat tileWidth = _watermarkConfig[@"tileWidth"]
+        ? [_watermarkConfig[@"tileWidth"] doubleValue] : 240.0;
+    CGFloat tileHeight = _watermarkConfig[@"tileHeight"]
+        ? [_watermarkConfig[@"tileHeight"] doubleValue] : 96.0;
+    CFAbsoluteTime requestedAt = CFAbsoluteTimeGetCurrent();
+    __block CFAbsoluteTime lockAcquiredAt = requestedAt;
+    __block CFAbsoluteTime stampFinishedAt = requestedAt;
+    __block int pageCount = 0;
+    __block BOOL stamped = NO;
+    NSError *lockError = nil;
+
+    NSLog(@"[PTStamperRepro] stamp requested");
+    [self emitReproInfo:@"PTStamper requested" elapsedMs:0];
+    @try {
+        [pdfViewCtrl DocLock:NO withBlock:^(PTPDFDoc * _Nullable doc) {
+            lockAcquiredAt = CFAbsoluteTimeGetCurrent();
+            if (!doc) {
+                return;
+            }
+
+            pageCount = [doc GetPageCount];
+            NSLog(@"[PTStamperRepro] write lock acquired waitMs=%.1f pages=%d",
+                  (lockAcquiredAt - requestedAt) * 1000.0, pageCount);
+            [self emitReproInfo:
+                [NSString stringWithFormat:@"write lock acquired; pages=%d", pageCount]
+                         elapsedMs:(lockAcquiredAt - requestedAt) * 1000.0];
+            if (pageCount <= 0) {
+                return;
+            }
+
+            PTPageSet *allPages = [[PTPageSet alloc]
+                initWithRange_start:1 range_end:pageCount filter:e_ptall];
+            if (useTiledImage) {
+                stamped = [self stampTiledImageWithLines:lines
+                                                opacity:opacity
+                                               tileSize:CGSizeMake(tileWidth, tileHeight)
+                                                  onDoc:doc
+                                                  pages:allPages];
+            } else {
+                PTStamper *stamper = [[PTStamper alloc]
+                    initWithSize_type:e_pts_font_size a:25.0 b:0.0];
+                [stamper SetTextAlignment:(PTTextAlignment)0];
+                [stamper SetPosition:0 vertical_distance:0 use_percentage:YES];
+                [stamper SetOpacity:opacity];
+                [stamper SetAsBackground:NO];
+                [stamper SetAsAnnotation:NO];
+                [stamper SetRotation:-50.0];
+                [stamper SetAlignment:e_pthorizontal_center
+                    vertical_alignment:e_ptvertical_center];
+                [stamper StampText:doc src_txt:text dest_pages:allPages];
+                stamped = YES;
+            }
+            stampFinishedAt = CFAbsoluteTimeGetCurrent();
+            NSLog(@"[PTStamperRepro] %@ complete stampMs=%.1f",
+                  useTiledImage ? @"StampImage" : @"StampText",
+                  (stampFinishedAt - lockAcquiredAt) * 1000.0);
+            [self emitReproInfo:
+                useTiledImage ? @"tiled StampImage complete" : @"StampText complete"
+                      elapsedMs:(stampFinishedAt - lockAcquiredAt) * 1000.0];
+            [pdfViewCtrl Update:YES];
+        } error:&lockError];
+    }
+    @catch (NSException *exception) {
+        NSString *reason = [NSString stringWithFormat:@"%@: %@",
+                            exception.name, exception.reason ?: @""];
+        [self emitWatermarkResult:NO reason:reason pageCount:pageCount
+                       lockWaitMs:(lockAcquiredAt - requestedAt) * 1000.0
+                          stampMs:0
+                          totalMs:(CFAbsoluteTimeGetCurrent() - requestedAt) * 1000.0];
+        return;
+    }
+
+    CFAbsoluteTime completedAt = CFAbsoluteTimeGetCurrent();
+    if (!stamped || lockError) {
+        [self emitWatermarkResult:NO
+                           reason:lockError.localizedDescription ?: @"stamp-not-applied"
+                        pageCount:pageCount
+                       lockWaitMs:(lockAcquiredAt - requestedAt) * 1000.0
+                          stampMs:0
+                          totalMs:(completedAt - requestedAt) * 1000.0];
+        return;
+    }
+
+    _watermarkStamped = YES;
+    [self emitWatermarkResult:YES reason:nil pageCount:pageCount
+                   lockWaitMs:(lockAcquiredAt - requestedAt) * 1000.0
+                      stampMs:(stampFinishedAt - lockAcquiredAt) * 1000.0
+                      totalMs:(completedAt - requestedAt) * 1000.0];
+}
